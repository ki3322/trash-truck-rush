    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
